---
import { SITE, CONTACT, PATHS, NAV } from '../consts';
import { SERVICES } from '../data/services';
import Img from './Img.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container">
		<div class="site-footer__top">
			<div class="site-footer__brand">
				<div class="stack" style="gap:12px">
					<Img name="logo-white" widths={[208, 279]} sizes="104px" />
					<span class="muted" style="font-size:16px">{SITE.tagline}</span>
				</div>
				<p class="display site-footer__claim">Wellness Branding Agency for <span class="c-lime">Scaling Up Businesses.</span></p>
				<p class="muted" style="max-width:460px">เราพร้อมยกระดับแบรนด์ของคุณให้โดดเด่น น่าเชื่อถือ และเป็นที่จดจำในธุรกิจ Wellness</p>
			</div>

			<nav aria-label="Footer" class="site-footer__nav">
				<div class="site-footer__col">
					<h2>Explore</h2>
					<ul>
						{
							NAV.map((n) => (
								<li>
									<a href={n.href}>{n.label}</a>
								</li>
							))
						}
					</ul>
				</div>
				<div class="site-footer__col">
					<h2>Services</h2>
					<ul>
						{
							SERVICES.map((s) => (
								<li>
									<a href={PATHS.service(s.slug)}>{s.name}</a>
								</li>
							))
						}
					</ul>
				</div>
				<div class="site-footer__col">
					<h2>Connect</h2>
					<address>
						<a href={CONTACT.lineUrl} rel="noopener">LINE {CONTACT.line}</a>
						<a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
						<a href={`tel:${CONTACT.phoneIntl}`}>{CONTACT.phone}</a>
						<span class="muted">{CONTACT.hours}</span>
						<span class="muted">{CONTACT.addressShort}</span>
					</address>
				</div>
			</nav>
		</div>

		<div class="site-footer__bottom">
			<span>
				Copyright © {year} - {SITE.name}. All rights reserved.
				<a href={PATHS.privacy}>Privacy Policy</a> · <a href={PATHS.terms}>Terms &amp; Conditions</a> · <a href={PATHS.sitemap}>Sitemap</a>
			</span>
			<span>Powered by <span class="c-lime" style="font-weight:600">{SITE.poweredBy}</span></span>
		</div>
	</div>
</footer>
