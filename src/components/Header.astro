---
import { NAV, PATHS, CONTACT, CTA_LABEL } from '../consts';
import { SERVICES } from '../data/services';
import Img from './Img.astro';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
	<div class="site-header__bar" data-header>
		<a href={PATHS.home} class="site-header__logo" aria-label="iPlan Wellness – หน้าแรก">
			<Img name="logo-white" widths={[120, 279]} sizes="60px" priority />
		</a>

		<nav aria-label="เมนูหลัก" class="nav">
			{
				NAV.map((item) =>
					'mega' in item ? (
						<span class="nav__mega" data-mega-trigger>
							<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
								{item.label}
							</a>
							<button type="button" class="nav__caret" aria-label="เปิดเมนู Our Services" aria-expanded="false" aria-controls="mega-menu" data-mega-toggle>
								<Icon name="chevron" size={14} stroke={2} />
							</button>
						</span>
					) : (
						<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
							{item.label}
						</a>
					),
				)
			}
		</nav>

		<a href={PATHS.contact} class="btn header-cta">{CTA_LABEL} <span aria-hidden="true">→</span></a>
		<button type="button" class="menu-btn" aria-label="เปิดเมนู" aria-haspopup="dialog" aria-controls="mobile-menu" data-menu-open>
			<Icon name="menu" size={22} stroke={2} />
		</button>

		<div id="mega-menu" class="mega" data-mega data-open="false" role="region" aria-label="Our Services">
			<div class="mega__intro">
				<span class="mega__title">Our Services</span>
				<span class="muted">Healthcare &amp; Wellness</span>
				<a href={PATHS.services} class="btn">View All Services <span aria-hidden="true">→</span></a>
			</div>
			<ul class="mega__grid" style="list-style:none;margin:0;padding:0">
				{
					SERVICES.map((s) => (
						<li>
							<a href={PATHS.service(s.slug)} class="mega__link" aria-current={path === PATHS.service(s.slug) ? 'page' : undefined}>
								<span class="chip" aria-hidden="true">
									<Icon name="arrow" size={16} stroke={2} />
								</span>
								{s.menuLabel}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</header>

<dialog id="mobile-menu" class="mobile-menu" aria-label="เมนู" data-menu>
	<div class="mobile-menu__top">
		<a href={PATHS.home} aria-label="iPlan Wellness – หน้าแรก"><Img name="logo-white" widths={[120, 279]} sizes="56px" /></a>
		<button type="button" class="mobile-menu__close" aria-label="ปิดเมนู" data-menu-close>
			<Icon name="close" size={22} stroke={2} />
		</button>
	</div>
	<nav aria-label="เมนูมือถือ" class="mobile-nav">
		{
			NAV.map((item) =>
				'mega' in item ? (
					<details open={path.startsWith(PATHS.services) || undefined}>
						<summary>
							{item.label}
							<span class="plus" aria-hidden="true" />
						</summary>
						<div class="mobile-nav__sub">
							{SERVICES.map((s) => (
								<a href={PATHS.service(s.slug)} aria-current={path === PATHS.service(s.slug) ? 'page' : undefined}>
									{s.menuLabel}
								</a>
							))}
							<a href={PATHS.services} class="mobile-nav__all">
								View All Services <span aria-hidden="true">→</span>
							</a>
						</div>
					</details>
				) : (
					<a href={item.href} class="mobile-nav__item" aria-current={isCurrent(item.href) ? 'page' : undefined}>
						{item.label}
					</a>
				),
			)
		}
	</nav>
	<div class="mobile-menu__foot">
		<a href={PATHS.contact} class="btn">{CTA_LABEL} <span aria-hidden="true">→</span></a>
		<div class="mobile-menu__contact">
			<a href={CONTACT.lineUrl} rel="noopener">LINE {CONTACT.line}</a>
			<a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
			<a href={`tel:${CONTACT.phoneIntl}`}>{CONTACT.phone}</a>
		</div>
	</div>
</dialog>

<script>
	const bar = document.querySelector<HTMLElement>('[data-header]');
	const mega = document.querySelector<HTMLElement>('[data-mega]');
	const toggle = document.querySelector<HTMLButtonElement>('[data-mega-toggle]');
	const trigger = document.querySelector<HTMLElement>('[data-mega-trigger]');

	let closeTimer: number | undefined;
	let hoverOpenedAt = 0;
	const setMega = (open: boolean) => {
		window.clearTimeout(closeTimer);
		if (!mega || !toggle) return;
		if (open && mega.dataset.open !== 'true') hoverOpenedAt = 0;
		mega.dataset.open = String(open);
		toggle.setAttribute('aria-expanded', String(open));
	};
	const isOpen = () => mega?.dataset.open === 'true';

	// Hover (mouse/trackpad only): open on the "Our Services" item or the panel itself,
	// close after a short grace delay so moving the pointer down into the panel never drops it.
	const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
	const onEnter = (e: PointerEvent) => {
		if (canHover.matches && e.pointerType === 'mouse') {
			const wasOpen = isOpen();
			setMega(true);
			if (!wasOpen) hoverOpenedAt = performance.now();
		}
	};
	const onLeave = (e: PointerEvent) => {
		if (!canHover.matches || e.pointerType !== 'mouse') return;
		window.clearTimeout(closeTimer);
		closeTimer = window.setTimeout(() => setMega(false), 220);
	};
	trigger?.addEventListener('pointerenter', onEnter);
	trigger?.addEventListener('pointerleave', onLeave);
	mega?.addEventListener('pointerenter', () => window.clearTimeout(closeTimer));
	mega?.addEventListener('pointerleave', onLeave);
	// Moving to another top-level link closes the panel straight away.
	document.querySelectorAll<HTMLElement>('.nav > a, .header-cta, .site-header__logo').forEach((el) =>
		el.addEventListener('pointerenter', (e) => {
			if (e.pointerType === 'mouse' && isOpen()) setMega(false);
		}),
	);

	// Click / keyboard
	// A click that lands right after hover opened the panel should keep it open, not toggle it shut.
	toggle?.addEventListener('click', () => {
		if (isOpen() && performance.now() - hoverOpenedAt < 700) return;
		setMega(!isOpen());
	});
	toggle?.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowDown') {
			e.preventDefault();
			setMega(true);
			mega?.querySelector<HTMLAnchorElement>('a')?.focus();
		}
	});
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && isOpen()) {
			setMega(false);
			toggle?.focus();
		}
	});
	document.addEventListener('click', (e) => {
		if (isOpen() && !bar?.contains(e.target as Node)) setMega(false);
	});
	mega?.addEventListener('focusout', (e) => {
		if (!mega.contains(e.relatedTarget as Node) && e.relatedTarget !== toggle) setMega(false);
	});

	const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
	const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
	openBtn?.addEventListener('click', () => {
		menu?.showModal();
		openBtn.setAttribute('aria-expanded', 'true');
	});
	document.querySelector('[data-menu-close]')?.addEventListener('click', () => menu?.close());
	menu?.addEventListener('close', () => openBtn?.setAttribute('aria-expanded', 'false'));
	window.matchMedia('(min-width: 1001px)').addEventListener('change', (e) => e.matches && menu?.close());
</script>
