---
// Previous / next post cards (v3 BlogPost design). Previous = older, next = newer.
// When there is no neighbour, the card links to the blog index ("ดูทั้งหมด").
import type { CollectionEntry } from 'astro:content';
import { PATHS } from '../consts';
import Img from './Img.astro';
import Icon from './Icon.astro';
import { formatDate } from '../lib/format';

type Post = CollectionEntry<'blog'>;
interface Props {
	prev?: Post;
	next?: Post;
}
const { prev, next } = Astro.props;
const items = [
	{ dir: 'prev', post: prev, label: '← PREVIOUS POST', rel: 'prev' },
	{ dir: 'next', post: next, label: 'NEXT POST →', rel: 'next' },
] as const;
---

<nav class="post-nav" aria-label="บทความก่อนหน้าและถัดไป">
	{
		items.map(({ dir, post, label, rel }) => (
			<a href={post ? PATHS.post(post) : PATHS.blog} class:list={['post-nav__card', `post-nav__card--${dir}`]} rel={post ? rel : undefined}>
				{post ? (
					<span class="post-nav__thumb">
						<Img src={post.data.heroImage} alt={post.data.heroAlt} sizes="112px" widths={[224, 336]} />
					</span>
				) : (
					<span class="post-nav__chip" aria-hidden="true">
						<span style={dir === 'prev' ? 'transform:rotate(180deg);display:inline-flex' : 'display:inline-flex'}>
							<Icon name="arrow" />
						</span>
					</span>
				)}
				<span class="post-nav__text">
					<span class="post-nav__label">{label}</span>
					<span class="post-nav__title">{post ? post.data.title : 'ดูทั้งหมด'}</span>
					{post && <time class="post-nav__date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>}
				</span>
			</a>
		))
	}
</nav>

<style>
	.post-nav {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 var(--gutter) 96px;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
		gap: 16px;
	}
	.post-nav__card {
		display: flex;
		align-items: center;
		gap: 20px;
		padding: 20px;
		border-radius: 18px;
		background: var(--pine);
		border: 1px solid var(--line);
		color: var(--cream);
		text-decoration: none;
		transition:
			border-color 0.2s,
			transform 0.2s;
	}
	.post-nav__card:hover {
		color: var(--cream);
		border-color: var(--line-lime);
		transform: translateY(-2px);
	}
	.post-nav__card--next {
		flex-direction: row-reverse;
	}
	.post-nav__card--next .post-nav__text {
		align-items: flex-end;
		text-align: right;
	}
	.post-nav__thumb {
		width: 112px;
		height: 112px;
		flex-shrink: 0;
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid var(--line);
		background: var(--pine-2);
	}
	.post-nav__thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.post-nav__chip {
		width: 56px;
		height: 56px;
		flex-shrink: 0;
		border-radius: var(--r-tile);
		background: var(--lime);
		color: var(--forest);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.post-nav__text {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 8px;
	}
	.post-nav__label {
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 1.5px;
		color: var(--lime);
	}
	.post-nav__title {
		font-family: var(--font-serif);
		font-size: 21px;
		font-weight: 500;
		line-height: 1.35;
		letter-spacing: -0.02em;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.post-nav__date {
		font-size: 13px;
		letter-spacing: 1px;
		color: var(--sand);
	}
	@media (max-width: 600px) {
		.post-nav__card {
			padding: 14px;
			gap: 14px;
		}
		.post-nav__thumb {
			width: 84px;
			height: 84px;
		}
		.post-nav__title {
			font-size: 18px;
		}
	}
</style>
