---
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';
import { PATHS, CONTACT } from '../consts';

interface Section {
	h: string;
	p: string[];
	li: string[];
}
interface Props {
	title: string;
	description: string;
	crumb: string;
	h1html: string;
	intro: string[];
	sections: Section[];
}
const { title, description, crumb, h1html, intro, sections } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
// The source copy contains a "[อีเมล/ช่องทางติดต่อ]" placeholder – fill it with the real contact.
const fill = (s: string) => s.replace('[อีเมล/ช่องทางติดต่อ]', `${CONTACT.email} หรือโทร ${CONTACT.phone}`);
---

<Layout title={title} description={description}>
	<PageHero crumbs={[{ label: "Home", href: PATHS.home }, { label: crumb }]}>
		<h1 class="display t-page c-lime" set:html={h1html.replace('<span>', '<span class="c-cream">')} />
		{intro.map((p) => <p class="lead">{p}</p>)}
	</PageHero>

	<section class="container section">
		<ol class="rows">
			{
				sections.map((s, i) => (
					<li class="row" style="gap:16px 48px">
						<span class="row__num">{pad(i + 1)}</span>
						<h2 class="row__title" style="flex: 1 1 min(300px, 100%)">
							{s.h}
						</h2>
						<div class="row__body" style="flex: 1.6 1 min(460px, 100%);gap:14px">
							{s.p.map((p) => (
								<p>{fill(p)}</p>
							))}
							{s.li.length > 0 && (
								<ul class="checks">
									{s.li.map((l) => (
										<li>{fill(l)}</li>
									))}
								</ul>
							)}
						</div>
					</li>
				))
			}
		</ol>
		<div class="cta-card" style="margin-top:56px;padding:40px">
			<p>
				หากมีข้อสงสัยเกี่ยวกับ Privacy Policy หรือ Terms &amp; Conditions สามารถติดต่อได้ที่:<br />
				Email: <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a> · เบอร์โทรติดต่อ : <a href={`tel:${CONTACT.phoneIntl}`}>{CONTACT.phone}</a>
			</p>
		</div>
	</section>
</Layout>
