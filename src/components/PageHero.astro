---
// Inner-page hero: midnight field, photo on the right, breadcrumb + H1.
import { SITE } from '../consts';
import Img from './Img.astro';

export interface Crumb {
	label: string;
	href?: string;
}
interface Props {
	crumbs: Crumb[];
	image?: string;
	imageAlt?: string;
	/**
	 * Optional muted background loop (files in /public/videos). `image` should be the video's first
	 * frame: it is the LCP image, the poster, and what reduced-motion / data-saver visitors see.
	 */
	video?: { webm?: string; mp4: string };
}
const { crumbs, image, imageAlt, video } = Astro.props;

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: crumbs.map((c, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		name: c.label,
		item: new URL(c.href ?? Astro.url.pathname, SITE.url).href,
	})),
};
---

<section class="page-hero">
	{
		image && (
			<div class="page-hero__media">
				<Img name={image} alt={imageAlt} sizes="(max-width: 900px) 100vw, 46vw" priority />
				{video && (
					<video class="page-hero__video" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" data-hero-video>
						{video.webm && <source src={video.webm} type="video/webm" />}
						<source src={video.mp4} type="video/mp4" />
					</video>
				)}
			</div>
		)
	}
	<div class="container page-hero__content">
		<nav aria-label="Breadcrumb" class="crumbs">
			<ol>
				{crumbs.map((c, i) => <li>{i < crumbs.length - 1 && c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
			</ol>
		</nav>
		<slot />
	</div>
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</section>

<script>
	// Start the background loop only when it makes sense: not for reduced motion or data saver.
	// The poster image stays underneath, so the video fades in over an identical first frame.
	const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
	const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
	const skip = matchMedia('(prefers-reduced-motion: reduce)').matches || conn?.saveData || /(^|-)2g$/.test(conn?.effectiveType ?? '');
	if (v && !skip) {
		v.preload = 'auto';
		v.addEventListener('playing', () => v.classList.add('is-playing'), { once: true });
		v.play().catch(() => {});
	}
</script>
