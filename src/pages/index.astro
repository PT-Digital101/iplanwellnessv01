---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Img from '../components/Img.astro';
import ClientLogos from '../components/ClientLogos.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE, PATHS, CTA_LABEL } from '../consts';
import { SERVICES } from '../data/services';
import { INDUSTRIES, PROCESS, FAQS, VIDEO_TAGS } from '../data/home';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const rot = [16, 9, 3, -3, -9, -16];
const pad = (n: number) => String(n).padStart(2, '0');

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: FAQS.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Layout
	title="Healthcare และ Wellness Digital Marketing Agency No.1"
	description="iPlan Wellness เอเจนซี่ Wellness Marketing ครบวงจรสำหรับธุรกิจ Healthcare สร้างแบรนด์ เว็บไซต์ SEO และวิดีโอ ให้คลินิก โรงพยาบาล และสปาเติบโตอย่างน่าเชื่อถือ"
	image="home-hero"
	schema={[faqSchema]}
>
	<!-- Hero -->
	<section class="home-hero">
		<div class="home-hero__media"><Img name="home-hero" priority /></div>
		<div class="home-hero__shade" aria-hidden="true"></div>
		<div class="container home-hero__content">
			<h1 class="display t-hero">Healthcare and Wellness<br /><span class="c-lime">Digital Marketing Agency.</span></h1>
			<p class="lead">
				เราเชี่ยวชาญด้าน <strong>การสร้างแบรนด์สำหรับธุรกิจ Healthcare และ Wellness</strong> ครบวงจร ตั้งแต่การวางกลยุทธ์, การสร้างภาพลักษณ์และตัวตนของแบรนด์
				ไปจนถึงการพัฒนาเว็บไซต์ที่สะท้อนเอกลักษณ์ของคุณอย่างมืออาชีพ พร้อมด้วย <strong>Digital Marketing, SEO และ Video Production</strong> เพื่อขับเคลื่อนธุรกิจ
				<strong>Wellness</strong> และ <strong>Healthcare</strong> ของคุณ
			</p>
			<div class="btn-row"><a href="#contact" class="btn">{CTA_LABEL} <span aria-hidden="true">→</span></a></div>
		</div>
	</section>

	<!-- Brand film -->
	<section class="container film" aria-label="Brand film">
		<div class="media-frame">
			<Img name="home-film" sizes="(max-width: 1360px) 100vw, 1312px" />
			{
				SITE.brandFilmUrl && (
					<a class="play-pill" href={SITE.brandFilmUrl} data-lightbox="youtube" aria-label="เล่นวิดีโอแนะนำแบรนด์ iPlan Wellness">
						<span class="play-pill__icon">
							<Icon name="play" size={18} />
						</span>
						Play brand film
					</a>
				)
			}
		</div>
	</section>

	<!-- About -->
	<section id="about" class="container section stack" style="gap:48px">
		<h2 class="display t-h2-lg c-lime" style="max-width:1100px">Wellness Branding Agency <span class="c-cream">for Scaling Up Businesses.</span></h2>
		<div class="split">
			<p class="split__lead">ธุรกิจ Wellness และ Healthcare ต้องการมากกว่าการตลาดทั่วไป แบรนด์ต้องน่าเชื่อถือ มีเอกลักษณ์ และเชื่อมต่อกับผู้บริโภคได้จริง</p>
			<div class="split__body">
				<p>
					I Plan Wellness จึงมุ่งเน้น <strong>การสร้างตัวตนและภาพลักษณ์ของแบรนด์</strong> ให้กับธุรกิจ Wellness บริการของเราครอบคลุมตั้งแต่
					<strong>Brand Strategy, Brand Identity, Website Development &amp; Design</strong> ไปจนถึงการสื่อสาร และ Digital Marketing
				</p>
				<p>
					ด้วยความเชี่ยวชาญในอุตสาหกรรม <strong>Wellness Tourism, Aesthetic Clinics, Hospitals, Spa &amp; Massage และ Wellness Products</strong> เราคือพันธมิตรด้าน Branding
					และ Website ที่พร้อมผลักดันธุรกิจของคุณให้เติบโต
				</p>
				<div class="btn-row" style="margin-top:8px">
					<a href={PATHS.contact} class="btn">ติดต่อเรา <span aria-hidden="true">→</span></a>
					<a href={PATHS.services} class="btn btn--outline">ดูบริการทั้งหมด</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Clients -->
	<section class="lime-band marquee" aria-labelledby="clients-h">
		<h2 id="clients-h" class="marquee__title">Clients &amp; Healthcare Wellness Partners</h2>
		<ClientLogos variant="forest" />
	</section>

	<!-- Services -->
	<section id="services" class="container section stack" style="gap:56px">
		<div class="section-head">
			<h2 class="display t-h2-lg c-lime">บริการ <span class="c-cream">Wellness Marketing</span> ของเรา</h2>
			<p>
				เราให้บริการด้าน <strong>Wellness Branding และ Digital Marketing</strong> ครอบคลุมทุกมิติ ตั้งแต่การสร้างแบรนด์ พัฒนาเว็บไซต์ การทำ SEO การวางแผนการตลาด
				รวมถึงการผลิตวิดีโอคุณภาพสูง เพื่อสร้างภาพลักษณ์และขยายฐานลูกค้าให้กับธุรกิจ Wellness ของคุณ
			</p>
		</div>
		<ul class="cells" style="list-style:none;margin:0">
			{
				SERVICES.map((s, i) => (
					<li>
						<a href={PATHS.service(s.slug)} class="cell" style="height:100%">
							<span class="cell__top">
								<span class="chip" aria-hidden="true">
									<Icon name="arrow" />
								</span>
								<span class="cell__num">{pad(i + 1)}</span>
							</span>
							<h3 class="cell__title">{s.name}</h3>
							<span class="cell__text">{s.nameTh}</span>
						</a>
					</li>
				))
			}
			<li>
				<a href="#contact" class="cell cell--cta" style="height:100%"><span class="cell__title">{CTA_LABEL} →</span></a>
			</li>
		</ul>
	</section>

	<!-- Industries -->
	<section class="dark-band section stack" style="gap:64px;overflow:hidden" aria-labelledby="industries-h">
		<h2 id="industries-h" class="display t-h2-lg c-lime container" style="max-width:1100px;text-align:center">
			ธุรกิจ <span class="c-cream">Healthcare</span> และ <span class="c-cream">Wellness</span> ที่เราให้บริการ
		</h2>
		<div class="industries">
			<ul class="industries__track">
				{
					INDUSTRIES.map((ind, i) => (
						<li>
							<a
								href={ind.cta ? PATHS.contact : PATHS.service(ind.service!)}
								class:list={['industry', { 'industry--cta': ind.cta }]}
								style={`--rot:${rot[i]}deg`}
							>
								{ind.image && <Img name={ind.image} sizes="300px" widths={[300, 600]} />}
								<span class="industry__num">{pad(i + 1)}</span>
								<h3 class="industry__title">{ind.title}</h3>
								<span class="industry__text">{ind.text}</span>
								{ind.cta && <span class="industry__go">สร้างแบรนด์ของคุณวันนี้ →</span>}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- Process -->
	<section class="container section stack" style="gap:48px">
		<div class="section-head">
			<h2 class="display t-h2-lg c-lime">กระบวนการทำงาน</h2>
			<span class="serif muted" style="font-size:23px">11 services · 4 steps each</span>
		</div>
		<div class="accordion">
			{
				PROCESS.map((p, i) => (
					<details name="process" open={i === 0 || undefined}>
						<summary>
							<span class="accordion__num">{pad(i + 1)}</span>
							<h3 class="accordion__title">{p.title}</h3>
							<span class="plus" aria-hidden="true" />
						</summary>
						<ol class="steps">
							{p.steps.map(([t, d], j) => (
								<li class="step">
									<span class="step__meta">
										<span>STEP</span>
										<span>{pad(j + 1)}</span>
									</span>
									<span class="step__title">{t}</span>
									<span class="step__text">{d}</span>
								</li>
							))}
						</ol>
					</details>
				))
			}
		</div>
	</section>

	<!-- Video production -->
	<section class="lime-band video-feature" aria-labelledby="video-h">
		<div class="video-feature__card">
			<div class="media-frame video-feature__media">
				<Img name="home-showreel" sizes="(max-width: 1000px) 100vw, 640px" />
				{
					SITE.showreelUrl && (
						<a class="play-round" href={SITE.showreelUrl} data-lightbox="youtube" aria-label="เล่นวิดีโอผลงาน Wellness Videos Production">
							<Icon name="play" size={30} />
						</a>
					)
				}
			</div>
			<div class="video-feature__body">
				<span class="eyebrow">Wellness Videos Production</span>
				<h2 id="video-h" class="display t-h3 c-lime">ทำไมธุรกิจสายสุขภาพ<br />ควรเล่าเรื่องผ่านวิดีโอ?</h2>
				<p>
					วิดีโอเป็นเครื่องมือสำคัญสำหรับ <strong>Healthcare</strong> และ <strong>Wellness Marketing</strong> เพราะช่วยสร้างการมีส่วนร่วม (engagement)
					ที่สูงกว่าคอนเทนต์รูปแบบอื่น และลูกค้าในธุรกิจ <strong>Healthcare, Wellness Tourism, Aesthetic Clinic</strong> และ <strong>Wellness Products</strong>
					มักตัดสินใจจากภาพลักษณ์ที่น่าเชื่อถือ วิดีโอจึงเป็นสื่อที่ทำให้แบรนด์ของคุณแตกต่างและน่าจดจำ
				</p>
				<ul class="tag-pills">
					{
						VIDEO_TAGS.map((t) => (
							<li>
								<span style={`background:${t.color}`} aria-hidden="true" />
								{t.label}
							</li>
						))
					}
				</ul>
				<a href={PATHS.service('wellness-videos-production')} class="btn">Wellness Videos Production <span aria-hidden="true">→</span></a>
			</div>
		</div>
	</section>

	<!-- Insights -->
	<section class="container section stack" style="gap:48px">
		<div class="section-head">
			<h2 class="display t-h2-lg c-lime">Wellness <span class="c-cream">Insights</span></h2>
			<a href={PATHS.blog} class="btn btn--outline">ดูทั้งหมด <span aria-hidden="true">→</span></a>
		</div>
		<div class="post-grid">{posts.map((p) => <PostCard post={p} />)}</div>
	</section>

	<!-- FAQ -->
	<section class="container section section--flush-top" style="display:flex;flex-wrap:wrap;gap:48px 72px">
		<div class="stack" style="flex: 1 1 min(360px, 100%);gap:20px">
			<h2 class="display t-h3 c-lime">คำถามที่พบบ่อย (FAQ)</h2>
			<div class="btn-row"><a href={PATHS.contact} class="btn">ติดต่อเรา <span aria-hidden="true">→</span></a></div>
		</div>
		<div class="accordion faq" style="flex: 1.6 1 min(600px, 100%);min-width:0">
			{
				FAQS.map((f, i) => (
					<details>
						<summary>
							<span class="accordion__num">{pad(i + 1)}</span>
							<h3>{f.q}</h3>
							<span class="plus" aria-hidden="true" />
						</summary>
						<p class="faq__a">{f.a}</p>
					</details>
				))
			}
		</div>
	</section>

	<!-- Contact -->
	<section id="contact" class="cta-wrap" aria-labelledby="contact-h">
		<div class="contact-panel">
			<div class="contact-panel__text">
				<h2 id="contact-h" class="display t-h3">
					วางกลยุทธ์และสร้างแบรนด์<br /><span class="c-lime">ที่ตอบโจทย์ธุรกิจ Wellness ของคุณ</span>
				</h2>
				<p class="lead">เราพร้อมยกระดับแบรนด์ของคุณให้โดดเด่น น่าเชื่อถือ และเป็นที่จดจำในธุรกิจ Wellness ด้วยทีมผู้เชี่ยวชาญที่เข้าใจทั้งสุขภาพ การแพทย์ และการตลาดอย่างแท้จริง</p>
			</div>
			<ContactForm id="home-contact-form" />
		</div>
	</section>
</Layout>

<script>
	// Exclusive accordions (<details name>) collapse the open panel above when another opens,
	// which shoves the tapped row off-screen on phones. Keep the tapped row where the finger is.
	for (const summary of document.querySelectorAll<HTMLElement>('.accordion summary')) {
		summary.addEventListener('click', () => {
			const before = summary.getBoundingClientRect().top;
			requestAnimationFrame(() => {
				const delta = summary.getBoundingClientRect().top - before;
				if (Math.abs(delta) > 1) window.scrollBy({ top: delta, behavior: 'instant' });
			});
		});
	}
</script>
